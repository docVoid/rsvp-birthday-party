# Kopieren nach .env.docker und Passwort setzen:  cp .env.docker.example .env.docker
# Hostname ist "postgres" (Name des Compose-Dienstes), nicht "localhost".
# Das Passwort muss dasselbe sein wie POSTGRES_PASSWORD in der .env.
DATABASE_URL="postgresql://rsvp:HIER_PASSWORT_EINTRAGEN@postgres:5432/rsvp_birthday?schema=public"
